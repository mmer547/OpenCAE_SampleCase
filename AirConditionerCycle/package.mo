within ;
package AirConditionerCycle "空調機の蒸気圧縮冷凍サイクル"
  extends Modelica.Icons.Package;
  annotation(version="1.2.0", uses(Modelica(version="4.1.0"), ExternalMedia(version="4.1.1")),
    Documentation(info="<html><p>Examples.RatedCooling で R134a の定格運転、Examples.OutdoorTemperatureRamp で外気温上昇時の応答を確認できます。Examples.RotaryCooling には部品別のロータリー圧縮機があり、CoolingCycle のダイアグラムから各機器を開けます。Examples.RefrigerantTests に R290、R32、R410A、亜臨界 CO₂ の標準・ロータリー型の実行例を収録しています。</p></html>"));
end AirConditionerCycle;
