within AirConditionerCycle;
package Examples "冷房サイクル、圧縮機単体、損失、部品、冷媒別の実行例"
  extends Modelica.Icons.ExamplesPackage;
  annotation(Documentation(info="<html><p>初めて実行する場合は <a href=\"modelica://AirConditionerCycle.Examples.CoolingCycles.RatedCooling\">CoolingCycles.RatedCooling</a> から始めます。</p><ul>
<li><a href=\"modelica://AirConditionerCycle.Examples.CoolingCycles\">CoolingCycles</a> では、冷凍回路で冷房能力や消費電力を調べます。</li>
<li><a href=\"modelica://AirConditionerCycle.Examples.CompressorTests\">CompressorTests</a> では、吸入・吐出圧力を指定して圧縮機を単体運転します。</li>
<li><a href=\"modelica://AirConditionerCycle.Examples.LossStudies\">LossStudies</a> では、機械・電気損失やシリンダのすきまを比較します。</li>
<li><a href=\"modelica://AirConditionerCycle.Examples.ComponentTests\">ComponentTests</a> では、圧縮機内の部品だけを試験します。</li>
<li><a href=\"modelica://AirConditionerCycle.Examples.RefrigerantTests\">RefrigerantTests</a> では、冷媒を選び、対応する運転例を開きます。</li>
</ul><p>BaseClasses には共通の試験台や試験用部品を収録しています。</p></html>"));
end Examples;
